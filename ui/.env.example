# CopilotKit Runtime URL — the Next.js API route (default works for local dev)
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=/api/copilotkit

# ADK FastAPI Backend URL — where your ag-ui-adk server listens
# MUST end with a trailing slash (ag-ui-adk mounts at path="/")
#
# Local sample backend (this repo, hardcoded port 8000):
COPILOTKIT_AGENT_URL=http://127.0.0.1:8000/
#
# At work, your Helix backend reads APP_PORT from its own environment to decide
# which port to listen on. Set COPILOTKIT_AGENT_URL to match that port:
#
#   COPILOTKIT_AGENT_URL=http://127.0.0.1:${APP_PORT}/
#
# For example, if APP_PORT=8080 in your Helix environment:
#   COPILOTKIT_AGENT_URL=http://127.0.0.1:8080/
#
# If the UI and backend are on separate machines, use the backend host:
#   COPILOTKIT_AGENT_URL=http://your-helix-host:${APP_PORT}/
#
# To find your work laptop's APP_PORT:
# 1. Check your Helix environment variables: echo $APP_PORT  (or print %APP_PORT%)
# 2. Check the Helix FastAPI startup (uvicorn.run host=..., port=APP_PORT)
# 3. Run: netstat -ano | findstr LISTENING  (to see which ports have servers)
# 4. Test: curl http://127.0.0.1:${APP_PORT}/  (should respond, not connection refused)