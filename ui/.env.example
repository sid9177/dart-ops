# CopilotKit Runtime URL — the Next.js API route (default works for local dev)
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=/api/copilotkit

# ADK FastAPI Backend URL — where your ag-ui-adk server listens
# MUST end with a trailing slash (ag-ui-adk mounts at path="/")
#
# Local sample backend (this repo):
COPILOTKIT_AGENT_URL=http://127.0.0.1:8000/
#
# At work, change this to your Helix ADK backend URL, e.g.:
# COPILOTKIT_AGENT_URL=http://your-helix-host:8000/
# COPILOTKIT_AGENT_URL=http://127.0.0.1:8080/
#
# To find your work laptop's URL:
# 1. Check how your Helix environment starts the ADK agent (look for uvicorn.run or add_adk_fastapi_endpoint)
# 2. Run: netstat -ano | findstr LISTENING  (to see which ports have servers)
# 3. Test: curl http://127.0.0.1:8000/  (should return something, not connection refused)