# CopilotKit Runtime URL — the Next.js API route (default works for local dev)
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=/api/copilotkit

# ADK FastAPI Backend URL — where your ag-ui-adk server listens
# MUST end with a trailing slash (ag-ui-adk mounts at path="/")
#
# Your Helix backend uses two environment variables to decide where to listen:
#   APP_PORT  — the port number (e.g., 8000, 8080)
#   RUN_MODE  — controls the host:
#     RUN_MODE=cluster  → backend binds to 0.0.0.0  (all interfaces)
#     RUN_MODE=<other>  → backend binds to 127.0.0.1  (localhost only)
#
# Set COPILOTKIT_AGENT_URL to match:
#
#   # Local / non-cluster mode (backend on localhost):
#   COPILOTKIT_AGENT_URL=http://127.0.0.1:${APP_PORT}/
#
#   # Cluster mode (backend on all interfaces, use localhost or the machine hostname):
#   COPILOTKIT_AGENT_URL=http://127.0.0.1:${APP_PORT}/
#   # or from another machine:
#   COPILOTKIT_AGENT_URL=http://your-helix-host:${APP_PORT}/
#
# Local sample backend (this repo, hardcoded port 8000, no RUN_MODE):
COPILOTKIT_AGENT_URL=http://127.0.0.1:8000/
#
# To find your work laptop's APP_PORT and RUN_MODE:
# 1. echo %APP_PORT%   (Windows)  or  echo $APP_PORT  (Linux/Mac)
# 2. echo %RUN_MODE%   (Windows)  or  echo $RUN_MODE (Linux/Mac)
# 3. Run: netstat -ano | findstr LISTENING  (to see which ports have servers)
# 4. Test: curl http://127.0.0.1:${APP_PORT}/  (should respond, not connection refused)